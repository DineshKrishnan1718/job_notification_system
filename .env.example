# Application
APP_ENV=development
SCHEDULE_TIME=08:00
TIMEZONE=Asia/Kolkata

# Search
JOB_ROLES=["QA Automation Engineer", "Python SDET", "Test Automation Architect"]
LOCATIONS=["Bengaluru", "Remote", "Hybrid"]
MIN_EXPERIENCE=3
MAX_EXPERIENCE=6
MIN_SALARY_LPA=8
REQUIRED_SKILLS=["Python", "Playwright", "PyTest", "API Testing"]
PREFERRED_SKILLS=["Docker", "Jenkins", "SQL", "Linux", "CI/CD"]
BANNED_KEYWORDS=["Java", "C#", "Ruby", "Manual Testing"]
MATCH_THRESHOLD=70

# Optional permitted/public JSON jobs API
JOB_API_URL=

# Local development database
DATABASE_URL=sqlite:///./jobs.db

# Docker PostgreSQL
POSTGRES_USER=job_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=job_database

# SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_TO=your_email@gmail.com
