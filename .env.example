# ==========================================
# SEARCH CONFIGURATIONS
# ==========================================
# Note: Pydantic parses lists from JSON-formatted strings. Use double quotes inside the brackets!
JOB_ROLES=["QA Automation Engineer", "Python SDET", "Test Automation Architect"]
LOCATIONS=["Bengaluru", "Remote", "Hybrid"]

# The minimum match score (0-100) required to send an email notification
MATCH_THRESHOLD=70

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# For local development without Docker, use SQLite:
DATABASE_URL=sqlite:///./jobs.db

# If running via Docker Compose (Phase 9), the docker-compose.yml will automatically 
# override this to use PostgreSQL, but you can define it here for reference:
# DATABASE_URL=postgresql://job_user:super_secret_password@db:5432/job_database

# ==========================================
# EMAIL NOTIFICATION (SMTP)
# ==========================================
# If using Gmail, use smtp.gmail.com. 
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Your sender email address
EMAIL_USERNAME=your_email@gmail.com

# SECURITY WARNING: Never use your real Google password here! 
# Generate a 16-character "App Password" from your Google Account Security settings.
EMAIL_PASSWORD=your_16_char_app_password

# Where the daily job reports should be sent
EMAIL_TO=your_email@gmail.com