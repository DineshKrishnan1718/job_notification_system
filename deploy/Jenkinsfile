pipeline {
    // Run on any available Jenkins worker node
    agent any

    // Define environment variables used across the pipeline
    environment {
        PYTHON_VERSION = 'python3'
        // In Jenkins, never hardcode secrets. We use the Jenkins Credentials Manager.
        // 'prod-env-file' would be the ID of a "Secret file" credential in Jenkins containing your .env
        ENV_FILE = credentials('prod-env-file') 
    }

    stages {
        stage('Checkout') {
            steps {
                // Pulls the code from the Git branch that triggered the job
                checkout scm
                echo "Code checked out successfully."
            }
        }

        stage('Install Dependencies') {
            steps {
                echo "Setting up virtual environment and installing dependencies..."
                sh '''
                    ${PYTHON_VERSION} -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Run Tests') {
            steps {
                echo "Running PyTest suite..."
                // Notice how our RAM-based database in Phase 8 saves us here! 
                // We don't need to spin up Postgres just to run tests.
                sh '''
                    . venv/bin/activate
                    pytest -v --tb=short
                '''
            }
        }

        stage('Build and Deploy') {
            steps {
                echo "Tests passed! Rebuilding and deploying Docker containers..."
                // 1. Copy the secure .env file injected by Jenkins into our workspace
                sh 'cp $ENV_FILE .env'
                
                // 2. Trigger Docker Compose (pointing to the file in the deploy/ folder)
                sh 'docker-compose -f deploy/docker-compose.yml up --build -d'
            }
        }
    }

    // This block runs after the stages, regardless of success or failure
    post {
        success {
            echo "✅ Pipeline completed successfully! The Job Notifier is running."
            // In a real setup, you could add a Slack or Email notification here
        }
        failure {
            echo "❌ Pipeline failed. Please check the logs."
            // If tests fail, Docker is never triggered. The old version keeps running!
        }
        always {
            // Clean up the workspace to save disk space on the Jenkins server
            echo "Cleaning up workspace..."
            sh 'rm -rf venv'
        }
    }
}